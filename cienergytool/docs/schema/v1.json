{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axa-oss.github.io/cienergy/schema/v1.json",
  "title": "cienergy energy report",
  "description": "SCI-compliant (ISO/IEC 21031:2024) energy and carbon report for a single CI/CD run.",
  "type": "object",
  "required": ["specVersion", "sciSpecVersion", "run", "runner", "energy", "carbon", "sci"],
  "properties": {
    "$schema":         { "type": "string", "format": "uri" },
    "specVersion":     { "type": "string", "const": "1.0.0" },
    "sciSpecVersion":  { "type": "string", "const": "ISO/IEC 21031:2024" },

    "run": {
      "type": "object",
      "required": ["id", "platform", "repository", "workflow", "commitSha", "startedAt", "endedAt", "durationSeconds"],
      "properties": {
        "id":               { "type": "string", "minLength": 1 },
        "platform":         { "type": "string", "enum": ["github-actions", "gitlab-ci", "azure-devops", "jenkins", "local"] },
        "repository":       { "type": "string", "minLength": 1 },
        "workflow":         { "type": "string", "minLength": 1 },
        "ref":              { "type": "string" },
        "commitSha":        { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "startedAt":        { "type": "string", "format": "date-time" },
        "endedAt":          { "type": "string", "format": "date-time" },
        "durationSeconds":  { "type": "number", "minimum": 0 }
      }
    },

    "runner": {
      "type": "object",
      "required": ["os", "arch", "vcpu", "ramGiB", "cpuModel", "tdpWatts", "provider", "region"],
      "properties": {
        "os":        { "type": "string" },
        "arch":      { "type": "string", "enum": ["x86_64", "amd64", "arm64", "aarch64"] },
        "vcpu":      { "type": "integer", "minimum": 1 },
        "ramGiB":    { "type": "number",  "minimum": 0 },
        "cpuModel":  { "type": "string" },
        "tdpWatts":  { "type": "number",  "minimum": 0 },
        "provider":  { "type": "string", "enum": ["github-hosted", "github-self-hosted", "gitlab-saas", "gitlab-self", "azure-pipelines", "jenkins", "local", "other"] },
        "region":    { "type": "string" },
        "isSpot":    { "type": "boolean" }
      }
    },

    "energy": {
      "type": "object",
      "required": ["totalKWh", "byStep"],
      "properties": {
        "totalKWh": { "type": "number", "minimum": 0 },
        "byStep": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kWh", "durationSeconds", "source"],
            "properties": {
              "name":             { "type": "string" },
              "kWh":              { "type": "number", "minimum": 0 },
              "durationSeconds":  { "type": "number", "minimum": 0 },
              "source":           { "type": "string", "enum": ["rapl", "kepler", "nvml", "eco-ci-model", "ccf-model", "codecarbon", "carbontracker"] },
              "cpuUtilPct":       { "type": "number", "minimum": 0, "maximum": 100 },
              "gpuKWh":           { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },

    "carbon": {
      "type": "object",
      "required": ["operationalGCO2eq", "embodiedGCO2eq", "totalGCO2eq", "gridIntensity"],
      "properties": {
        "operationalGCO2eq": { "type": "number", "minimum": 0 },
        "embodiedGCO2eq":    { "type": "number", "minimum": 0 },
        "totalGCO2eq":       { "type": "number", "minimum": 0 },
        "gridIntensity": {
          "type": "object",
          "required": ["valueGCO2eqPerKWh", "source", "zone", "timestamp"],
          "properties": {
            "valueGCO2eqPerKWh": { "type": "number", "minimum": 0 },
            "source":            { "type": "string", "enum": ["electricitymaps", "watttime", "ember-monthly", "ccf-static", "user-override"] },
            "zone":              { "type": "string" },
            "timestamp":         { "type": "string", "format": "date-time" }
          }
        },
        "embodiedSource": { "type": "string", "enum": ["boavizta", "ccf-static", "user-override", "none"] }
      }
    },

    "sci": {
      "type": "object",
      "required": ["value", "unit", "functionalUnit", "R"],
      "properties": {
        "value":          { "type": "number", "minimum": 0 },
        "unit":           { "type": "string", "const": "gCO2eq" },
        "functionalUnit": { "type": "string" },
        "R":              { "type": "number", "minimum": 0.0001 }
      }
    },

    "cache": {
      "type": "object",
      "properties": {
        "hit":                  { "type": "boolean" },
        "savedKWhEstimate":     { "type": "number", "minimum": 0 },
        "savedGCO2eqEstimate":  { "type": "number", "minimum": 0 }
      }
    },

    "metadata": {
      "type": "object",
      "properties": {
        "team":       { "type": "string" },
        "costCenter": { "type": "string" },
        "labels":     { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}

